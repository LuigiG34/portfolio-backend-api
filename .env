# Symfony
APP_ENV=dev
APP_SECRET=25bec5587c0ba098075011c6d57ceacd
APP_SHARE_DIR=var/share
DEFAULT_URI=http://localhost

# MySQL
MYSQL_DATABASE=portfolio
MYSQL_USER=app
MYSQL_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_HOST=db

# RabbitMQ
RABBITMQ_USER=app
RABBITMQ_PASSWORD=change_me

# Symfony DB connection
DATABASE_URL="mysql://${MYSQL_USER}:${MYSQL_PASSWORD}@${MYSQL_HOST}:3306/${MYSQL_DATABASE}?serverVersion=8.0"

# Mailer
MAILER_DSN=smtp://mailhog:1025

###> symfony/messenger ###
MESSENGER_TRANSPORT_DSN=amqp://app:change_me@rabbitmq:5672/%2f/messages
###< symfony/messenger ###

###> lexik/jwt-authentication-bundle ###
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=change_me_passphrase
###< lexik/jwt-authentication-bundle ###

###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
